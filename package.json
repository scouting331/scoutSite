  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "prettier": {
    "tabWidth": 2,
    "overrides": [
      {
        "files": ["*.md", "*.mdx"],
        "options": {
          "parser": "markdown",
          "proseWrap": "always",
          "printWidth": 80
        }
      },
      {
        "files": ["*.json"],
        "options": {
          "parser": "json"
        }
      },
      {
        "files": ["*.js"],
        "options": {
          "parser": "babel"
        }
      },
      {
        "files": ["*.css"],
        "options": {
          "parser": "css"
        }
      }
    ],
    "endOfLine": "lf"
  }
}
