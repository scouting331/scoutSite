{
  "name": "scout-site-331",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "npm run build && wrangler deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "preview": "npm run build && wrangler dev",
    "tools:setup": "pip install -r scripts/requirements.txt",
    "tools:image-processor": "python scripts/image_processor",
    "spellcheck": "cspell \"{blog,cookbook,docs,static,src/pages}/**/*.{md,mdx,csv}\""
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/faster": "^3.10.0",
    "@docusaurus/plugin-sitemap": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@docusaurus/theme-mermaid": "^3.10.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@fortawesome/free-regular-svg-icons": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "csv-parse": "^7.0.1",
    "docusaurus-plugin-cookie-consent": "^4.6.0",
    "leaflet": "^1.9.4",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-photo-album": "^3.6.0",
    "react-slick": "^0.31.0",
    "slick-carousel": "^1.8.1",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/types": "^3.10.0",
    "cspell": "^10.0.1",
    "prettier": "^3.9.4",
    "wrangler": "^4.112.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": "^24.0.0"
  },
  "prettier": {
    "tabWidth": 2,
    "overrides": [
      {
        "files": [
          "*.md",
          "*.mdx"
        ],
        "options": {
          "parser": "markdown",
          "proseWrap": "always",
          "printWidth": 80
        }
      },
      {
        "files": [
          "*.json"
        ],
        "options": {
          "parser": "json"
        }
      },
      {
        "files": [
          "*.js"
        ],
        "options": {
          "parser": "babel"
        }
      },
      {
        "files": [
          "*.css"
        ],
        "options": {
          "parser": "css"
        }
      }
    ],
    "endOfLine": "lf"
  },
  "cspell": {
    "version": "0.2",
    "language": "en-US",
    "dictionaryDefinitions": [
      {
        "name": "scout-dictionary",
        "path": ".github/.scout-dictionary",
        "addWords": true
      }
    ],
    "dictionaries": [
      "scout-dictionary"
    ],
    "allowCompoundWords": true,
    "caseSensitive": false,
    "minWordLength": 2,
    "ignoreRegExpList": [
      "HTML-tag",
      "HTML-attribute",
      "Inline-Code",
      "require\\.context\\([^)]*\\)",
      "youtubeId=\"[A-Za-z0-9_-]+\"",
      "class(Name)?=\\\"[^\\\"]+\\\""
    ]
  }
}
